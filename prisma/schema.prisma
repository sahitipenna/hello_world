generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations need a real session-level Postgres lock, which a pooled
  // connection (Neon's "-pooler" host, PgBouncer transaction mode) doesn't
  // reliably support — `prisma migrate deploy` hangs/times out acquiring
  // it (P1002). DIRECT_URL should be Neon's non-pooled connection string;
  // `url` above stays pooled since that's what the app's normal request-time
  // queries want. See https://pris.ly/d/migrate-advisory-locking
  directUrl = env("DIRECT_URL")
}

/// A visitor of the app. Anonymous by default, identified by a random id
/// stored in an httpOnly cookie (see lib/auth.ts) — no signup/password yet.
/// See ARCHITECTURE.md §4 for why this is the deliberate MVP choice.
model User {
  id                String   @id
  createdAt         DateTime @default(now())
  lastSeenAt        DateTime @default(now()) // bumped on every request that resolves a visitor (lib/auth.ts) — basis for return-rate/DAU queries, see README
  plan              String   @default("free") // "free" | "premium" — kept in sync by the Razorpay webhook (lib/razorpay.ts); falls back to a manual demo toggle when Razorpay isn't configured
  razorpaySubscriptionId String? @unique // Razorpay's sub_... id, once this visitor has started checkout
  timeBudgetMinutes Int? // 5 | 15 | 30 | 45 — personalization from onboarding
  sectionOrder      String? // JSON-encoded string[] of section keys
  hiddenSections    String? // JSON-encoded string[] of section keys

  // Optional Google sign-in (lib/googleAuth.ts, app/api/auth/google/*).
  // Anonymous by default (see the model comment above) — signing in just
  // attaches these to the visitor's EXISTING row (same id, same data)
  // rather than creating a new account, unless that Google account was
  // already linked to a different row (a previous device), in which case
  // the browser's identity cookie switches to that established row instead.
  email    String? @unique
  name     String?
  image    String?
  googleId String? @unique

  interests    UserInterest[]
  todoChecks   DailyTodoCheck[]
  promptEdits  PromptEdit[]
  sectionEdits SectionEdit[]
  todoItems    TodoListItem[]
  quizEdits    QuizEdit[]
  quizProgress QuizProgress[]
  bookmarks    Bookmark[]
}

// ---------------------------------------------------------------------------
// Section configuration — the core "change it without redeploying" table.
// The daily-edition page renders exactly these rows, in this order, gating
// premium ones for free users. Adding, renaming, reordering, enabling, or
// re-pricing a section is a row edit via /admin, not a code change.
// ---------------------------------------------------------------------------

model Section {
  id               String  @id @default(cuid())
  key              String  @unique // "know" | "play" | "look" | "read" | "wander" | "readnext" | "wonder" | "do" | ...
  eyebrow          String // small-caps label shown above the title, e.g. "KNOW"
  title            String // e.g. "5 things happening in the world"
  tagline          String
  order            Int     @default(0)
  premium          Boolean @default(false)
  enabled          Boolean @default(true)
  minTimeMinutes   Int     @default(5) // shown expanded once the user's time budget reaches this
  freeCount        Int? // for multi-item sections (KNOW, DO): how many items free users see; null = all
}

// ---------------------------------------------------------------------------
// Content pools. Every row optionally carries a `scheduledDate` — if set,
// that item is used for that exact date (real editorial control); if not,
// the app deterministically rotates through the unscheduled pool so every
// date still resolves to a complete edition. See ARCHITECTURE.md §2.
// ---------------------------------------------------------------------------

/// KNOW — short, accessible items about the world. Editorially written or
/// summarized, never scraped/reproduced wire copy (see rightsStatus).
model NewsItem {
  id              String    @id @default(cuid())
  title           String
  summary         String
  source          String
  sourceUrl       String?
  category        String    @default("world")
  readingTimeMin  Int       @default(1)
  scheduledDate   String?
  createdAt       DateTime  @default(now())
}

/// LOOK — one artwork, with an interpretive write-up, not just metadata.
model Artwork {
  id            String   @id @default(cuid())
  title         String
  artist        String
  year          String   @default("")
  medium        String   @default("")
  museum        String   @default("")
  image         String? // URL; if empty, the Met search query below is used live
  metQuery      String? // fallback: live-search the Met's Open Access API
  description   String // the 100–250 word "notice how..." interpretation
  sourceUrl     String?
  category      String   @default("art")
  scheduledDate String?
  createdAt     DateTime @default(now())
}

/// READ — a short literary excerpt. rightsStatus governs what's shown:
/// "public_domain" or "editorial" may show a real excerpt; "licensed" or
/// "summary_only" must not reproduce protected text (see the app's use).
model LiteraryItem {
  id            String   @id @default(cuid())
  author        String
  work          String
  excerpt       String
  context       String
  source        String
  sourceUrl     String?
  rightsStatus  String   @default("public_domain") // "public_domain" | "editorial" | "licensed" | "summary_only"
  category      String   @default("books")
  scheduledDate String?
  createdAt     DateTime @default(now())
}

/// WANDER — a short travel piece, original editorial writing by default.
model TravelItem {
  id              String   @id @default(cuid())
  location        String
  title           String
  text            String
  authorOrSource  String   @default("Go Dilly")
  sourceUrl       String?
  category        String   @default("travel")
  scheduledDate   String?
  createdAt       DateTime @default(now())
}

/// READ NEXT — one book recommendation, personal in tone.
model Book {
  id                     String   @id @default(cuid())
  title                  String
  author                 String
  cover                  String?
  description            String
  whyRead                String
  genre                  String   @default("")
  estimatedReadingTime   String   @default("")
  category               String   @default("books")
  scheduledDate          String?
  createdAt              DateTime @default(now())
}

/// WONDER — one fascinating, verifiable "wait, really?" fact.
model Wonder {
  id            String   @id @default(cuid())
  title         String
  body          String
  category      String   @default("science")
  source        String   @default("")
  scheduledDate String?
  createdAt     DateTime @default(now())
}

/// DO — small, optional, non-productivity activities. Pooled and drawn 5 at
/// a time per ISO week (not per day), same rotation as before.
model DailyTask {
  id        String   @id @default(cuid())
  title     String
  category  String   @default("")
  createdAt DateTime @default(now())
}

/// PLAY — the crossword is still generated (constraint solver, unchanged);
/// only the themed word banks move into the database.
model CrosswordTheme {
  id       String @id @default(cuid())
  title    String
  category String @default("")
  words    Json // [{ word: string, clue: string }]
}

/// Comic of the day — architecture placeholder only (see ARCHITECTURE.md
/// §2 / PRD §13). Disabled by default until a real license exists; when one
/// does, this becomes a real scheduled content pool like the others.
model Comic {
  id            String  @id @default(cuid())
  label         String  @default("Comic of the Day")
  note          String // e.g. "Licensing pending — this is a placeholder."
  externalUrl   String?
  scheduledDate String?
}

/// A curated external link (never reproduced content, just a citation +
/// short teaser) shown on the "come back tomorrow" screen a visitor hits
/// when they navigate past today's edition. Admin-curated via /admin, same
/// as every other pool, so a real editor picks what's linked.
model BonusArticle {
  id        String   @id @default(cuid())
  title     String
  source    String // e.g. "The Atlantic", "The New York Times"
  url       String
  teaser    String   @default("")
  category  String   @default("")
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Personalization
// ---------------------------------------------------------------------------

/// The fixed set of interest categories users can pick from during onboarding.
model InterestTag {
  id    String @id @default(cuid())
  slug  String @unique
  label String
  emoji String @default("")
  order Int    @default(0)

  users UserInterest[]
}

model UserInterest {
  userId String
  tagId  String
  weight Int    @default(1)

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag  InterestTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([userId, tagId])
}

// ---------------------------------------------------------------------------
// Pricing — copy and price live here, not in a component.
// ---------------------------------------------------------------------------

model PricingPlan {
  id          String   @id @default(cuid())
  key         String   @unique // "free" | "premium"
  name        String
  priceINR    Int      @default(0)
  priceUSD    Int      @default(0)
  interval    String   @default("month")
  features    Json // string[]
  order       Int      @default(0)
}

// ---------------------------------------------------------------------------
// Save / bookmark — one generic table covers every content type.
// ---------------------------------------------------------------------------

model Bookmark {
  id          String   @id @default(cuid())
  userId      String
  contentType String // "news" | "artwork" | "literary" | "travel" | "book" | "wonder"
  contentId   String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentType, contentId])
}

// ---------------------------------------------------------------------------
// Per-user state for the DO section (weekly, not date-scoped) and any
// section's inline edit — kept from the earlier build for the "extra"
// personal sections (My To-Do List, Write Something) that stay in the
// system but are disabled by default in favor of the PRD's 8 sections.
// ---------------------------------------------------------------------------

model DailyTodoCheck {
  id      String  @id @default(cuid())
  userId  String
  dateISO String // actually an ISO-week key ("2026-W39") for the DO section
  index   Int
  done    Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateISO, index])
}

model PromptEdit {
  id      String @id @default(cuid())
  userId  String
  dateISO String
  index   Int
  text    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateISO, index])
}

model SectionEdit {
  id        String @id @default(cuid())
  userId    String
  dateISO   String
  sectionId String
  field     String
  value     String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateISO, sectionId, field])
}

model TodoListItem {
  id        String   @id @default(cuid())
  userId    String
  text      String
  done      Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model QuizGenre {
  id    String @id @default(cuid())
  slug  String @unique
  label String
  emoji String @default("")
  order Int    @default(0)
}

model QuizQuestion {
  id         String @id @default(cuid())
  genre      String
  difficulty String @default("easy")
  index      Int
  question   String
  answer     String

  @@unique([genre, difficulty, index])
}

model QuizEdit {
  id            String @id @default(cuid())
  userId        String
  genre         String
  difficulty    String
  questionIndex Int
  question      String
  answer        String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, genre, difficulty, questionIndex])
}

model QuizProgress {
  id          String   @id @default(cuid())
  userId      String
  genre       String
  difficulty  String
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, genre, difficulty])
}
