{
  "name": "go-dilly",
  "version": "0.1.0",
  "private": true,
  "description": "Go Dilly: a beautifully curated daily cultural ritual — world curiosities, art, literature, travel writing, a book recommendation, a puzzle, and five little things to do — personalized, config-driven, one edition per day of the year.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma migrate deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx --env-file=.env prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@vercel/analytics": "^2.0.1",
    "next": "16.3.5",
    "posthog-js": "^1.434.14",
    "razorpay": "^2.9.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "uuid": "^14.0.2"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "mysql2": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "10.4.19",
    "postcss": "8.5.28",
    "prisma": "^6.19.3",
    "tailwindcss": "3.4.4",
    "tsx": "^4.23.13",
    "typescript": "5.5.3"
  }
}
