{
  "name": "daybook",
  "version": "0.1.0",
  "private": true,
  "description": "A small daily almanac of news bites, a mini crossword, a comic break, a poem, an art spotlight, a travel vignette, a book recommendation, and five hobby prompts — one bundle per day of the year.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "16.3.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "uuid": "^14.0.2"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "mysql2": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "10.4.19",
    "postcss": "8.5.28",
    "prisma": "^6.19.3",
    "tailwindcss": "3.4.4",
    "tsx": "^4.23.13",
    "typescript": "5.5.3"
  }
