# A Postgres connection string. For local development, either run Postgres
# yourself (e.g. `postgresql://postgres:password@localhost:5432/godilly`)
# or use a free hosted instance (Vercel Postgres, Neon, Supabase, ...) — the
# same URL works for both local dev and a deployed instance.
#
# If your provider distinguishes a pooled vs. direct connection string (Neon,
# Supabase, PgBouncer in front of Postgres generally), point this at the
# POOLED one — it's what the app's normal request-time queries use.
DATABASE_URL="postgresql://user:password@host:5432/godilly"

# Migrations (`prisma migrate deploy`) need a real session-level Postgres
# lock, which a pooled/PgBouncer connection doesn't reliably support and can
# hang or time out on (Prisma error P1002). Point this at the same database's
# DIRECT (non-pooled) connection string. If your provider has no pooled/direct
# distinction (a plain local Postgres, for instance), just repeat the same
# value as DATABASE_URL.
DIRECT_URL="postgresql://user:password@host:5432/godilly"

# Shared secret gating /admin (the content management interface). Set this
# to something long and random before deploying publicly.
ADMIN_SECRET="change-me"
